<?xml version="1.0" encoding="utf-8"?>
<!-- Les comptes ne partent pas dans la sauvegarde Google ni vers un autre téléphone :
     ils restent sur l'appareil et dans les fichiers .sqlite. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
