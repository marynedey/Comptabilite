# Configuration du service de sauvegarde « Mes comptes ».
# À copier dans /etc/mes-comptes-nas/sauvegarde.env, puis : chmod 600 (le jeton n'est lisible que par root).

# Dossier où arrivent les sauvegardes (chemin absolu du dossier partagé OpenMediaVault,
# colonne « Absolute path » de Storage → Shared Folders, + un sous-dossier si tu veux).
DOSSIER=/srv/dev-disk-by-uuid-XXXX/Partage/Comptes/sauvegardes

# Mot de passe à recopier dans l'app (Sauvegarde NAS → Jeton). Pour en générer un :
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JETON=remplacer-par-un-long-jeton-aleatoire

# Port d'écoute.
PORT=8080

# Combien de sauvegardes garder (les plus anciennes sont supprimées) ; 0 = toutes.
GARDER=90

# HTTPS directement par le service (option B du LISEZMOI, accès par le VPN seulement).
# Laisser vide avec le tunnel Cloudflare (option A) : c'est Cloudflare qui fait le HTTPS.
CERT=
CLE=
