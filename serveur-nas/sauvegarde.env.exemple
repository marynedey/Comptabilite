# Configuration du service de sauvegarde « Mes comptes ».
# À copier dans /etc/mes-comptes-nas/sauvegarde.env, puis : chmod 600 (le jeton n'est lisible que par root).

# Dossier où arrivent les sauvegardes : le sous-dossier du partage OMV, tel qu'il est monté dans ce LXC.
DOSSIER=/mnt/comptes/sauvegardes

# Mot de passe à recopier dans l'app (Sauvegarde NAS → Jeton). Pour en générer un :
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JETON=remplacer-par-un-long-jeton-aleatoire

# Port d'écoute.
PORT=8080

# Combien de sauvegardes garder (les plus anciennes sont supprimées) ; 0 = toutes.
GARDER=90

# HTTPS fait par le service lui-même (option B du LISEZMOI, sans reverse proxy).
# Laisser vide avec le tunnel Cloudflare (option A) ou un reverse proxy : ce sont eux qui font le HTTPS.
CERT=
CLE=
