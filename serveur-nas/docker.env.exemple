# À copier en « .env » à côté de docker-compose.yml, puis : chmod 600 .env
# Jeton à recopier dans l'app : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JETON=remplacer-par-un-long-jeton-aleatoire
# Chemin, dans ce LXC, du dossier des sauvegardes (partage OMV monté).
DOSSIER_HOTE=/mnt/comptes/sauvegardes
# UID:GID qui peut écrire dans ce dossier (côté partage OMV : souvent un utilisateur du groupe users = 100).
UID_GID=1000:100
# Nombre de sauvegardes gardées (0 = toutes).
GARDER=90
